# Build environment for the CrossCrease NHL 17 Linux runtime (used by tools/linux/build_release.sh).
# Ubuntu 24.04 sets the oldest supported glibc (2.39). Clang 19 with GCC 14's C++ library is the
# combination upstream shadPS4's Linux CI uses on Ubuntu 24.04 (Clang 18 is too old for the source, and
# Clang 20+ fails on a forward_like bug in GCC 14.2's library). Everything comes from the Ubuntu archive.
# The emulator's own dependencies are built from the submodules in externals/ and linked statically;
# SDL loads X11, Wayland, audio and the Vulkan driver from the player's system at run time, so only
# their headers are needed here.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git python3 cmake ninja-build pkg-config file \
        clang-19 clang-tools-19 lld-19 llvm-19 libstdc++-14-dev \
        libasound2-dev libpulse-dev libpipewire-0.3-dev libjack-dev libsndio-dev \
        libudev-dev libevdev-dev \
        libx11-dev libxext-dev libxcursor-dev libxi-dev libxrandr-dev libxss-dev libxtst-dev \
        libxkbcommon-dev libwayland-dev wayland-protocols libdecor-0-dev libegl-dev libgl-dev \
        libdrm-dev libgbm-dev libvulkan-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
