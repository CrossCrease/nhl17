<?xml version="1.0"?>
<!--
  CrossCrease compatibility patch for NHL 17 update 1.08 (eboot.bin, verified against CUSA04326).
  Addresses use the shadPS4 convention (ELF virtual address + 0x400000).

  Invite login fix: accepting a game invitation from the main menu could stay on "Connecting".
  The invite flow clears all pending UI service-request callbacks, but when the invite is accepted
  from the main menu the game's UI already sends its login check before that clear runs, so the
  login reply is dropped. The patch records the request counter when a game mode is cleaned up
  (CleanupServiceRequestForMode) and keeps the callbacks of requests made after it, as long as at
  most 8 requests have been made since. Every other pending callback is still cleared.
  Code lives in an unused automation-harness function (vaddr 0x1217060); 12 bytes of state live in
  the zeroed space after .bss (vaddr 0x496bf08).
-->
<Patch>
  <TitleID>
    <ID>CUSA04326</ID>
    <ID>CUSA04330</ID>
  </TitleID>
  <Metadata Title="NHL 17" Name="CrossCrease invite login fix" Author="CrossCrease" PatchVer="1.0" AppVer="01.08" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="bytes" Address="0x01617060" Value="8b87a000000089059c4e750348893d9d4e7503554889e541574156534883ec18e9b8480500cccccc4d8b6e08488b45b8483b05794e750375228b88a00000002b0d634e750383f9087711418b453c2b05544e75037e05e9fd470500498b7d18e9d4470500"/>
      <Line Type="bytes" Address="0x0166b890" Value="e9f3b7faff909090"/>
      <Line Type="bytes" Address="0x0166b930" Value="e92bb7faff9090909090909090"/>
    </PatchList>
  </Metadata>
  <!--
    Online Team Play hub tile: the hub script (ui/features/playonline/vvms/otpversus/otpversus.lua
    in databigs/boot.big) draws the Ranked OTP Quick Match tile only from the data source's initial
    data and ignores later updates (OnNewDataFromDataSource), but that service is deferred, so its
    data always arrives as an update and the tile stayed empty. The Online Versus script draws both.
    The first line routes the quick-match update to OnQuickMatchInitialData, as Online Versus does;
    the next two blank two comments (same length) so the recompressed chunk fits its old space.
    The tile is drawn only after the player's avatar request answers. The OTP services
    script (same archive, record 0x12d6890) ignores a failed request, so a player
    without a downloadable avatar never got the tile; Online Versus calls back with no avatar and
    shows the placeholder. The fourth line does the same for OTP; the fifth blanks a comment.
    Type chunkzip_text is a CrossCrease addition: the runtime rebuilds the record from the player's
    own boot.big when it is first read; no game data is in this file.
  -->
  <Metadata Title="NHL 17" Name="CrossCrease OTP hub tile fix" Author="CrossCrease" PatchVer="1.0" AppVer="01.08" AppElf="eboot.bin" isEnabled="true">
    <PatchList>
      <Line Type="chunkzip_text" File="databigs/boot.big" Offset="0x012dca00" Find="OnNewDataFromDataSource = function( reference, data ) o:OnNewDataFromDataSource( data ) end" Replace="OnNewDataFromDataSource = function( reference, data ) o:OnQuickMatchInitialData( data ) end"/>
      <Line Type="chunkzip_text" File="databigs/boot.big" Offset="0x012dca00" Find="-- clamp the level value at 1 as this is used for a progress bar that expects values from 0-1" Replace="---------------------------------------------------------------------------------------------"/>
      <Line Type="chunkzip_text" File="databigs/boot.big" Offset="0x012dca00" Find="-- this means that any profile with 100+ games played will display a full progress bar" Replace="--------------------------------------------------------------------------------------"/>
      <Line Type="chunkzip_text" File="databigs/boot.big" Offset="0x012d6890" Find="function (errorCode, errorSummary) return true end)" Replace="function(e,s)  callback(nil,false) return true end)"/>
      <Line Type="chunkzip_text" File="databigs/boot.big" Offset="0x012d6890" Find="--In case this call fails (As disconnected or logged out) turn off the datawatch" Replace="--------------------------------------------------------------------------------"/>
    </PatchList>
  </Metadata>
</Patch>
